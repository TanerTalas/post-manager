---
import Legal from '~/layouts/Legal.astro';
import { legalPage } from '~/data/legal';
import { localePaths, langFrom, translator } from '~/i18n';

export const getStaticPaths = localePaths;

const lang = langFrom(Astro.params.lang);
const t = translator(lang);
const page = legalPage(lang, 'privacy');
---

<Legal title={page.title} kicker={page.kicker} slug={page.slug} lang={lang}>
  {
    page.body.map((section) => (
      <div style="margin-bottom:30px">
        <h2 style="font-family:var(--font-heading);font-weight:600;font-size:20px;margin:0 0 8px">
          {section.head}
        </h2>
        <p style="font-size:15px;line-height:1.85;margin:0;text-wrap:pretty">{section.text}</p>
      </div>
    ))
  }
  <p style="font-size:12px;line-height:1.7;margin:36px 0 0;color:color-mix(in srgb, var(--color-text) 50%, transparent);text-wrap:pretty">
    {t('legal.draftNote')}
  </p>
</Legal>
