---
import Base from './Base.astro';
import SiteFooter from '~/components/SiteFooter.astro';
import HeaderBar from '~/islands/HeaderBar';
import { alternateOf, to, type Lang } from '~/i18n';

interface Props {
  title: string;
  description?: string;
  route: 'home' | 'app';
  lang: Lang;
}

const { title, description, route, lang } = Astro.props;

// Worked out here rather than in the island: a plain href works before any
// JavaScript has loaded.
const altUrl = alternateOf(Astro.url.pathname, lang);
const homeUrl = to('/', lang);
const appUrl = to('/app', lang);
const tourUrl = `${appUrl}?tour=1`;
---

<Base title={title} description={description} lang={lang}>
  <div style="min-height:100vh;display:flex;flex-direction:column">
    <HeaderBar
      client:load
      route={route}
      lang={lang}
      altUrl={altUrl}
      homeUrl={homeUrl}
      appUrl={appUrl}
      tourUrl={tourUrl}
    />

    <main style="flex:1;width:100%;margin:0 auto;padding:34px 20px 64px;max-width:1180px">
      <slot />
    </main>

    <SiteFooter lang={lang} />
  </div>

  <script>
    // The chrome slides away on the way down and returns on the way up. Kept out
    // of the islands: it is presentation only and never touches stored state.
    const header = document.querySelector<HTMLElement>('[data-shell-header]');
    const chrome = document.querySelector<HTMLElement>('[data-shell-chrome]');

    if (header && chrome) {
      let last: number | null = null;
      let hidden = false;
      let flipped = 0;
      let frame = 0;

      const onScroll = () => {
        if (frame) return;
        frame = requestAnimationFrame(() => {
          frame = 0;
            // The tour pins the chrome open, so it can point at the tab bar.
          if (document.body.dataset.tour === 'on') return;

          const y = Math.max(0, window.scrollY);
          if (last === null) {
            last = y;
            return;
          }
          const delta = y - last;
          if (Math.abs(delta) < 14) return;
          last = y;

          const next = delta > 0 && y > 130;
          if (next === hidden) return;
          if (Date.now() - flipped < 420) return;

          flipped = Date.now();
          hidden = next;
          header.style.top = hidden ? '-56px' : '0px';
          chrome.style.opacity = hidden ? '0' : '1';
        });
      };

      window.addEventListener('scroll', onScroll, { passive: true });
    }
  </script>
</Base>
