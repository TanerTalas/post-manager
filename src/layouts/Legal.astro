---
import Base from './Base.astro';
import { LEGAL_NAV, type LegalSlug } from '~/data/legal';

interface Props {
  title: string;
  kicker: string;
  slug: LegalSlug;
  description?: string;
}

const { title, kicker, slug, description } = Astro.props;
const dim = 'color-mix(in srgb, var(--color-text) 55%, transparent)';
---

<Base title={title} description={description}>
  <div style="min-height:100vh;display:flex;flex-direction:column">
    <div style="max-width:1080px;width:100%;margin:0 auto;padding:26px 20px 70px;flex:1">
      <a
        class="btn btn-ghost"
        href="/app"
        data-return
        style="position:sticky;top:20px;z-index:20;font-size:14px;gap:9px;padding:6px 8px;margin-left:-8px;background:var(--color-bg);width:fit-content"
      >
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
          <path d="M20 7a5 5 0 0 1-5 5H5"></path>
          <path d="m9 8-4 4 4 4"></path>
        </svg>
        Return
      </a>

      <nav class="legal-strip" aria-label="Legal pages">
        <div class="legal-strip-track noscroll" data-legal-strip>
          {
            LEGAL_NAV.map((item) => (
              <a
                href={item.href}
                style={`flex:none;padding:6px 2px;font-size:13px;white-space:nowrap;color:${
                  item.slug === slug ? 'var(--color-accent)' : dim
                };border-bottom:1px solid ${
                  item.slug === slug ? 'var(--color-accent)' : 'transparent'
                };font-style:${item.slug === 'contact' ? 'italic' : 'normal'}`}
              >
                {item.label}
              </a>
            ))
          }
        </div>
      </nav>

      <div class="legal-grid">
        <nav class="legal-side" aria-label="Legal pages">
          {
            LEGAL_NAV.map((item) => (
              <a
                href={item.href}
                style={`display:block;padding:9px 0;font-size:14px;border-bottom:1px solid var(--color-divider);color:${
                  item.slug === slug
                    ? 'var(--color-accent)'
                    : item.slug === 'contact'
                      ? 'var(--color-accent-700)'
                      : 'var(--color-text)'
                }`}
              >
                {item.label}
              </a>
            ))
          }
        </nav>

        <article style="min-width:0;max-width:70ch">
          <h1 style="font-family:var(--font-heading);font-weight:600;font-size:clamp(30px,4.4vw,42px);line-height:1.15;letter-spacing:-0.015em;margin:0">
            {title}
          </h1>
          <div style="font-size:11px;letter-spacing:0.16em;text-transform:uppercase;color:var(--color-accent);margin-top:14px;font-variant-numeric:tabular-nums">
            {kicker}
          </div>
          <hr class="hr" style="margin:22px 0 26px" />
          <slot />
        </article>
      </div>
    </div>

    <footer style="border-top:1px solid var(--color-divider)">
      <div
        style={`max-width:1080px;margin:0 auto;padding:20px;display:flex;flex-wrap:wrap;gap:14px;align-items:center;justify-content:space-between;font-size:12px;color:${dim}`}
      >
        <span style="font-variant-numeric:tabular-nums">&copy; 2026 Post Manager</span>
        <a class="btn btn-ghost" href="/app" data-return style="font-size:12px">Return</a>
      </div>
    </footer>
  </div>

  <style>
    .legal-strip {
      display: none;
      margin-top: 20px;
      border-top: 1px solid var(--color-divider);
      border-bottom: 1px solid var(--color-divider);
      padding: 6px 0;
    }

    .legal-strip-track {
      display: flex;
      gap: 18px;
      overflow-x: auto;
      touch-action: pan-y;
    }

    .legal-grid {
      display: grid;
      gap: 44px;
      grid-template-columns: minmax(150px, 200px) 1fr;
      margin-top: 38px;
      align-items: start;
    }

    .legal-side {
      display: flex;
      flex-direction: column;
      gap: 2px;
      position: sticky;
      top: 80px;
      z-index: 1;
      background: var(--color-bg);
    }

    @media (max-width: 760px) {
      .legal-strip {
        display: block;
      }

      .legal-grid {
        grid-template-columns: 1fr;
      }

      .legal-side {
        display: none;
      }
    }
  </style>

  <script>
    // Return goes back where the reader came from, and falls back to the app.
    for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-return]')) {
      link.addEventListener('click', (event) => {
        if (history.length > 1 && document.referrer.startsWith(location.origin)) {
          event.preventDefault();
          history.back();
        }
      });
    }
  </script>
</Base>
