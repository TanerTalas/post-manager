---
import { translator, to, type Lang } from '~/i18n';

interface Props {
  /** The legal shell keeps a narrower measure than the app shell. */
  width?: number;
  lang: Lang;
}

const { width = 1180, lang } = Astro.props;
const t = translator(lang);
const path = (route: string) => to(route, lang);
---

<div class="contact-strip">
  <div class="contact-strip-inner" style={`max-width:${width}px`}>
    <p style="margin:0;font-family:var(--font-serif);font-size:15px;font-weight:500;letter-spacing:0.005em">
      {t('footer.invite')}
    </p>
    <a
      class="btn btn-primary"
      href={path('/contact')}
      style="font-size:12px;padding:6px 14px;min-height:0;white-space:nowrap"
    >
      {t('footer.contactMe')}
    </a>
  </div>
</div>

<footer class="site-footer">
  <div class="site-footer-inner" style={`max-width:${width}px`}>
    <span style="font-variant-numeric:tabular-nums">{t('footer.copyright')}</span>
    <div class="site-footer-links">
      <a href={path('/privacy')}>{t('legal.privacy')}</a>
      <a href={path('/terms')}>{t('legal.terms')}</a>
      <a href={path('/cookies')}>{t('legal.cookies')}</a>
      <a href={path('/contact')}>{t('legal.contact')}</a>
    </div>
  </div>
</footer>

<style>
  .contact-strip {
    border-top: 1px solid var(--color-divider);
    background: var(--color-surface);
  }

  .contact-strip-inner,
  .site-footer-inner {
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: center;
    justify-content: space-between;
  }

  .contact-strip-inner {
    padding: 12px 20px;
  }

  .site-footer {
    border-top: 1px solid var(--color-divider);
  }

  .site-footer-inner {
    padding: 20px;
    font-size: 12px;
    color: color-mix(in srgb, var(--color-text) 55%, transparent);
  }

  .site-footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
  }

  /* Once the rows wrap there is no left and right any more, only a stack, and
     a stack reads better centred than ragged against the left edge. */
  @media (max-width: 640px) {
    .contact-strip-inner,
    .site-footer-inner,
    .site-footer-links {
      justify-content: center;
      text-align: center;
    }

    .contact-strip-inner {
      flex-direction: column;
      gap: 12px;
    }

    .site-footer-inner {
      flex-direction: column;
      gap: 16px;
    }
  }
</style>
